[Unit]
Description=moon e-paper controller config server
After=multi-user.target
Requires=network.target

[Service]
Type=simple
User=luna
# Forward the host server (at :8000) to be served at :80
ExecStartPre=sudo iptables -A INPUT -i wlan0 -p tcp --dport 80 -j ACCEPT
ExecStartPre=sudo iptables -A INPUT -i wlan0 -p tcp --dport 8000 -j ACCEPT
ExecStartPre=sudo iptables -A PREROUTING -t nat -i wlan0 -p tcp --dport 80 -j REDIRECT --to-port 8000
ExecStart=$DIR/loader/venv/bin/python $DIR/loader/config_server.py
Restart=always

[Install]
WantedBy=multi-user.target
